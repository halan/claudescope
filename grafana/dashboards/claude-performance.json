{
  "title": "Claude Code — Performance",
  "uid": "claude-performance",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "session_id",
        "label": "Session",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "query": "label_values(claude_code_token_usage_tokens_total, session_id)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Internal errors",
        "datasource": { "type": "loki", "uid": "Loki" },
        "enable": true,
        "iconColor": "red",
        "target": { "expr": "{service_name=\"claude-code\"} | event_name=\"internal_error\"", "refId": "Anno" }
      }
    ]
  },
  "panels": [

    { "id": 100, "type": "row", "title": "API request latency — headline", "collapsed": false, "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 } },

    { "id": 1, "type": "stat", "title": "API requests in range",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [ { "expr": "sum(count_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session_id\" [$__range]))", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "graphMode": "area", "colorMode": "value", "textMode": "auto", "reduceOptions": { "calc": "lastNotNull", "fields": "", "values": false } } },

    { "id": 2, "type": "stat", "title": "p50 duration",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [ { "expr": "quantile_over_time(0.50, {service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session_id\" | unwrap duration_ms [$__range]) by ()", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 0 } },
      "options": { "graphMode": "area", "colorMode": "value", "textMode": "auto", "reduceOptions": { "calc": "lastNotNull", "fields": "", "values": false } } },

    { "id": 3, "type": "stat", "title": "p95 duration",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [ { "expr": "quantile_over_time(0.95, {service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session_id\" | unwrap duration_ms [$__range]) by ()", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ {"color": "green", "value": null}, {"color": "yellow", "value": 5000}, {"color": "red", "value": 15000} ] } } },
      "options": { "graphMode": "area", "colorMode": "value", "textMode": "auto", "reduceOptions": { "calc": "lastNotNull", "fields": "", "values": false } } },

    { "id": 4, "type": "stat", "title": "p99 duration",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [ { "expr": "quantile_over_time(0.99, {service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session_id\" | unwrap duration_ms [$__range]) by ()", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ {"color": "green", "value": null}, {"color": "yellow", "value": 10000}, {"color": "red", "value": 30000} ] } } },
      "options": { "graphMode": "area", "colorMode": "value", "textMode": "auto", "reduceOptions": { "calc": "lastNotNull", "fields": "", "values": false } } },

    { "id": 101, "type": "row", "title": "Latency over time", "collapsed": false, "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 } },

    { "id": 5, "type": "timeseries", "title": "api_request percentiles",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        { "expr": "quantile_over_time(0.50, {service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session_id\" | unwrap duration_ms [5m]) by ()", "legendFormat": "p50", "refId": "A" },
        { "expr": "quantile_over_time(0.95, {service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session_id\" | unwrap duration_ms [5m]) by ()", "legendFormat": "p95", "refId": "B" },
        { "expr": "quantile_over_time(0.99, {service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session_id\" | unwrap duration_ms [5m]) by ()", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } } },

    { "id": 6, "type": "timeseries", "title": "p95 by model",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [ { "expr": "quantile_over_time(0.95, {service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session_id\" | unwrap duration_ms [5m]) by (model)", "legendFormat": "p95 {{model}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "ms" } } },

    { "id": 102, "type": "row", "title": "Slowest individual calls", "collapsed": false, "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 } },

    { "id": 7, "type": "table", "title": "Top 10 slowest api_requests",
      "description": "Ranked by duration. Look at input_tokens vs output_tokens to distinguish 'big input' from 'long generation'. Click a session_id to filter the Overview by it.",
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [ {
        "expr": "{service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session_id\" | duration_ms > 0",
        "refId": "A",
        "queryType": "range",
        "maxLines": 5000
      } ],
      "transformations": [
        { "id": "extractFields", "options": { "source": "labels", "format": "json", "keepTime": true, "replace": true } },
        { "id": "convertFieldType", "options": { "fields": {}, "conversions": [
          { "targetField": "duration_ms",   "destinationType": "number" },
          { "targetField": "input_tokens",  "destinationType": "number" },
          { "targetField": "output_tokens", "destinationType": "number" },
          { "targetField": "cache_read_tokens", "destinationType": "number" }
        ] } },
        { "id": "sortBy", "options": { "sort": [ { "field": "duration_ms", "desc": true } ] } },
        { "id": "limit", "options": { "limitField": 10 } },
        { "id": "organize", "options": {
          "indexByName": { "Time": 0, "duration_ms": 1, "model": 2, "input_tokens": 3, "output_tokens": 4, "cache_read_tokens": 5, "query_source": 6, "session_id": 7 },
          "excludeByName": {
            "request_id": true, "prompt_id": true, "event_name": true, "event_sequence": true,
            "event_timestamp": true, "observed_timestamp": true, "host_arch": true, "os_type": true,
            "os_version": true, "scope_name": true, "scope_version": true, "service_name": true,
            "service_version": true, "terminal_type": true, "user_id": true,
            "cache_creation_tokens": true, "cost_usd": true, "cost_usd_micros": true,
            "loki_attribute_labels": true, "speed": true, "effort": true,
            "project": false
          },
          "renameByName": {
            "duration_ms": "Duration (ms)", "model": "Model",
            "input_tokens": "Input tok", "output_tokens": "Output tok",
            "cache_read_tokens": "Cache read", "query_source": "Source",
            "session_id": "Session", "project": "Project"
          }
        } }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [
        { "matcher": { "id": "byName", "options": "Duration (ms)" },
          "properties": [
            { "id": "unit", "value": "ms" },
            { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30000 },
              { "color": "red", "value": 120000 }
            ] } }
          ] },
        { "matcher": { "id": "byName", "options": "Session" },
          "properties": [
            { "id": "links", "value": [
              { "title": "Filter Overview by this session",
                "url": "/d/claude-overview?var-session_id=${__data.fields.Session}" }
            ] }
          ] }
      ] } },

    { "id": 10, "type": "table", "title": "Slow calls (>60s) — chronological",
      "description": "Same data, filtered to calls slower than 60 seconds, sorted by time. Helps you reconstruct 'what was I doing when the model got slow?'",
      "gridPos": { "x": 0, "y": 25, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [ {
        "expr": "{service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session_id\" | duration_ms > 60000",
        "refId": "A",
        "queryType": "range",
        "maxLines": 5000
      } ],
      "transformations": [
        { "id": "extractFields", "options": { "source": "labels", "format": "json", "keepTime": true, "replace": true } },
        { "id": "convertFieldType", "options": { "fields": {}, "conversions": [
          { "targetField": "duration_ms",   "destinationType": "number" },
          { "targetField": "input_tokens",  "destinationType": "number" },
          { "targetField": "output_tokens", "destinationType": "number" }
        ] } },
        { "id": "sortBy", "options": { "sort": [ { "field": "Time", "desc": false } ] } },
        { "id": "organize", "options": {
          "indexByName": { "Time": 0, "duration_ms": 1, "model": 2, "input_tokens": 3, "output_tokens": 4, "query_source": 5, "session_id": 6 },
          "excludeByName": {
            "request_id": true, "prompt_id": true, "event_name": true, "event_sequence": true,
            "event_timestamp": true, "observed_timestamp": true, "host_arch": true, "os_type": true,
            "os_version": true, "scope_name": true, "scope_version": true, "service_name": true,
            "service_version": true, "terminal_type": true, "user_id": true,
            "cache_creation_tokens": true, "cache_read_tokens": true,
            "cost_usd": true, "cost_usd_micros": true,
            "loki_attribute_labels": true, "speed": true, "effort": true
          },
          "renameByName": {
            "duration_ms": "Duration (ms)", "model": "Model",
            "input_tokens": "Input tok", "output_tokens": "Output tok",
            "query_source": "Source", "session_id": "Session"
          }
        } }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [
        { "matcher": { "id": "byName", "options": "Duration (ms)" },
          "properties": [
            { "id": "unit", "value": "ms" },
            { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "yellow", "value": null },
              { "color": "orange", "value": 120000 },
              { "color": "red", "value": 240000 }
            ] } }
          ] },
        { "matcher": { "id": "byName", "options": "Session" },
          "properties": [
            { "id": "links", "value": [
              { "title": "Filter Overview by this session",
                "url": "/d/claude-overview?var-session_id=${__data.fields.Session}" }
            ] }
          ] }
      ] } },

    { "id": 103, "type": "row", "title": "Tool execution latency", "collapsed": false, "gridPos": { "x": 0, "y": 33, "w": 24, "h": 1 } },

    { "id": 8, "type": "timeseries", "title": "p95 tool execution by tool",
      "gridPos": { "x": 0, "y": 34, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [ { "expr": "quantile_over_time(0.95, {service_name=\"claude-code\"} | event_name=\"tool_result\" | session_id=~\"$session_id\" | unwrap duration_ms [5m]) by (tool_name)", "legendFormat": "p95 {{tool_name}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "ms" } } },

    { "id": 9, "type": "bargauge", "title": "Avg tool duration (last window)",
      "gridPos": { "x": 12, "y": 34, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [ { "expr": "avg_over_time({service_name=\"claude-code\"} | event_name=\"tool_result\" | session_id=~\"$session_id\" | unwrap duration_ms [$__range]) by (tool_name)", "legendFormat": "{{tool_name}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 0 } },
      "options": { "reduceOptions": { "calc": "lastNotNull", "fields": "", "values": false }, "orientation": "horizontal", "displayMode": "gradient" } },

    { "id": 11, "type": "table", "title": "Per-tool latency breakdown",
      "description": "Full percentile breakdown per tool over the selected range. Joins 5 Loki queries by tool_name.",
      "gridPos": { "x": 0, "y": 42, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        { "expr": "sum by (tool_name) (count_over_time({service_name=\"claude-code\"} | event_name=\"tool_result\" | session_id=~\"$session_id\" [$__range]))", "legendFormat": "calls", "refId": "A", "queryType": "instant" },
        { "expr": "quantile_over_time(0.50, {service_name=\"claude-code\"} | event_name=\"tool_result\" | session_id=~\"$session_id\" | unwrap duration_ms [$__range]) by (tool_name)", "legendFormat": "p50", "refId": "B", "queryType": "instant" },
        { "expr": "quantile_over_time(0.95, {service_name=\"claude-code\"} | event_name=\"tool_result\" | session_id=~\"$session_id\" | unwrap duration_ms [$__range]) by (tool_name)", "legendFormat": "p95", "refId": "C", "queryType": "instant" },
        { "expr": "quantile_over_time(0.99, {service_name=\"claude-code\"} | event_name=\"tool_result\" | session_id=~\"$session_id\" | unwrap duration_ms [$__range]) by (tool_name)", "legendFormat": "p99", "refId": "D", "queryType": "instant" },
        { "expr": "max_over_time({service_name=\"claude-code\"} | event_name=\"tool_result\" | session_id=~\"$session_id\" | unwrap duration_ms [$__range]) by (tool_name)", "legendFormat": "max", "refId": "E", "queryType": "instant" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": {
          "indexByName": { "tool_name": 0, "Value #A": 1, "Value #B": 2, "Value #C": 3, "Value #D": 4, "Value #E": 5 },
          "excludeByName": { "Time": true },
          "renameByName": {
            "tool_name": "Tool",
            "Value #A": "Calls", "Value #B": "p50 (ms)", "Value #C": "p95 (ms)",
            "Value #D": "p99 (ms)", "Value #E": "max (ms)"
          }
        } },
        { "id": "sortBy", "options": { "sort": [ { "field": "p95 (ms)", "desc": true } ] } }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [
        { "matcher": { "id": "byRegexp", "options": "(p50|p95|p99|max).*" },
          "properties": [ { "id": "unit", "value": "ms" }, { "id": "decimals", "value": 0 },
            { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [ {"color": "green", "value": null}, {"color": "yellow", "value": 500}, {"color": "orange", "value": 2000}, {"color": "red", "value": 10000} ] } }
          ] },
        { "matcher": { "id": "byName", "options": "Calls" }, "properties": [ { "id": "decimals", "value": 0 } ] }
      ] } }

  ]
}
